@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using ReportIssueInPristina.Application.Services
@using ReportIssueInPristina.Web.Data

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentUserService CurrentUserService

<header class="main-navbar">

    <div class="nav-container">

        <!-- =========================
             BRAND
             ========================= -->

        <NavLink href="/" class="brand" Match="NavLinkMatch.All" @onclick="CloseMenu">

            <div class="brand-logo">
                <img src="/images/logo.png" alt="Prishtina Civic Helper" />
            </div>

        </NavLink>


        @if (isAuthenticated)
        {
            <!-- =========================
                 MOBILE MENU BUTTON
                 ========================= -->

            <button class="mobile-menu-button" type="button" @onclick="ToggleMenu" aria-label="Hap menunë"
                    aria-expanded="@isMenuOpen">

                <span></span>
                <span></span>
                <span></span>

            </button>


            <!-- =========================
                 NAVIGATION
                 ========================= -->

            <nav class="desktop-nav @(isMenuOpen ? "mobile-open" : "")">

                <NavLink href="/" class="nav-link" Match="NavLinkMatch.All" @onclick="CloseMenu">

                    Kryefaqja

                </NavLink>


                <NavLink href="/report-issue" class="nav-link" @onclick="CloseMenu">

                    Raporto problem

                </NavLink>


                <div class="nav-dropdown @(isReportsMenuOpen ? "open" : "")">
                    <button type="button" class="nav-link nav-dropdown-toggle" @onclick="ToggleReportsMenu"
                            aria-expanded="@isReportsMenuOpen" aria-controls="reports-submenu">
                        Raportimet
                        <span class="dropdown-caret">▾</span>
                    </button>

                    <div class="nav-dropdown-menu" id="reports-submenu">
                        <a href="/issues" class="dropdown-link" @onclick="NavigateToAllIssues"
                           @onclick:preventDefault="true">
                            Shiko Raportimet
                        </a>

                        <a href="/map" class="dropdown-link" @onclick="CloseMenu">
                            Harta
                        </a>

                        <a href="/my-issues" class="dropdown-link" @onclick="NavigateToMyIssues"
                           @onclick:preventDefault="true">
                            Raportimet e mia
                        </a>
                    </div>
                </div>

                <AuthorizeView Roles="Admin">
                    <NavLink href="/admin/categories" class="nav-link" @onclick="CloseMenu">

                        Kategoritë

                    </NavLink>
                </AuthorizeView>


                <NavLink href="/about" class="nav-link" @onclick="CloseMenu">

                    Rreth projektit

                </NavLink>


                <NavLink href="/contact" class="nav-link" @onclick="CloseMenu">

                    Kontakto

                </NavLink>

            </nav>


            <!-- =========================
                 AUTHENTICATED USER
                 ========================= -->

            <div class="auth-buttons">
                <AuthorizeView>
                    <Authorized>

                        <span class="welcome-user">
                            Mirë se erdhe, @userName 👋
                        </span>
                    </Authorized>

                </AuthorizeView>
                <form method="post" action="/Account/Logout" class="d-inline">
                    <AntiforgeryToken />
                    <input name="returnUrl" type="hidden"
                           value="@NavigationManager.ToBaseRelativePath(NavigationManager.Uri)" />
                    <button type="submit" class="login-btn">
                        <span class="auth-icon">↪</span>
                        <span>Dil</span>
                    </button>
                </form>

            </div>
        }
        else
        {
            <!-- =========================
                 GUEST AUTH BUTTONS
                 ========================= -->

            <div class="auth-buttons">

                <a href="/Account/Login" class="login-btn">

                    <span class="auth-icon">♙</span>

                    <span>Hyr</span>

                </a>


                <a href="/Account/Register" class="signup-btn">

                    <span class="auth-icon">+</span>

                    <span>Regjistrohu</span>

                </a>

            </div>
        }

    </div>

</header>


@code {

    private bool isMenuOpen;

    private bool isReportsMenuOpen;

    private bool isAuthenticated;

    private string userName = "";


    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        await LoadAuthenticationState();
    }


    private async Task LoadAuthenticationState()
    {
        await CurrentUserService.InitializeAsync();

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        isAuthenticated =
            user.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            userName = CurrentUserService.Name ??
            user.FindFirst("name")?.Value ??
            user.Identity?.Name ??
            "Përdorues";
        }
    }


    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
        isReportsMenuOpen = false;
    }

    private void ToggleReportsMenu()
    {
        isReportsMenuOpen = !isReportsMenuOpen;
    }


    private void CloseMenu()
    {
        isMenuOpen = false;
        isReportsMenuOpen = false;
    }

    private void NavigateToAllIssues()
    {
        CloseMenu();
        NavigationManager.NavigateTo("/issues", forceLoad: true);
    }

    private void NavigateToMyIssues()
    {
        CloseMenu();
        NavigationManager.NavigateTo("/my-issues", forceLoad: true);
    }


    // Logout is performed by posting a form to /Account/Logout so the server
    // can perform SignInManager.SignOutAsync inside a real HTTP request where
    // response headers (cookies) can be modified.


    private async void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        isMenuOpen = false;
        isReportsMenuOpen = false;

        await LoadAuthenticationState();

        await InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}