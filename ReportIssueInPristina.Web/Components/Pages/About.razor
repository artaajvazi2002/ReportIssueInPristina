@page "/about"

<PageTitle>Rreth projektit - Prishtina Civic Helper</PageTitle>

<div class="about-page">

    <!-- HERO -->
    <section class="about-hero">

        <div class="about-hero-content">

            <h1>
                Rreth<br />
                <span>Prishtina <strong>Civic Helper</strong></span>
            </h1>

            <div class="green-line"></div>

            <p>
                Prishtina Civic Helper është një platformë që lidh
                qytetarët me autoritetet lokale për ta bërë qytetin
                tonë më të pastër, më të sigurt dhe më të mirë për të gjithë.
            </p>

        </div>

        <div class="about-hero-image">

            <img src="/images/prishtina-city.jpg"
                 alt="Qyteti i Prishtinës" />

        </div>

    </section>


    <!-- MISIONI YNË -->
    <section class="mission-section">

        <div class="section-title">

            <h2>Misioni ynë</h2>

            <div class="small-line"></div>

        </div>

        <p class="mission-description">
            Misioni ynë është t'u japim qytetarëve një mënyrë të
            thjeshtë për të raportuar problemet në lagjet e tyre
            dhe për të ndjekur përparimin e raportimeve.
            Së bashku mund të ndërtojmë një Prishtinë më të mirë.
        </p>


        <div class="mission-cards">

            <div class="mission-card">

                <div class="mission-icon green">
                    <span>♟</span>
                </div>

                <h3>Fuqizimi i qytetarëve</h3>

                <p>
                    U japim qytetarëve mundësinë të raportojnë
                    problemet dhe të kontribuojnë në komunitetin e tyre.
                </p>

            </div>


            <div class="mission-card">

                <div class="mission-icon blue">
                    <span>◉</span>
                </div>

                <h3>Transparenca</h3>

                <p>
                    Promovojmë transparencën duke mundësuar
                    ndjekjen e problemeve dhe progresit të tyre.
                </p>

            </div>


            <div class="mission-card">

                <div class="mission-icon orange">
                    <span>⚙</span>
                </div>

                <h3>Shërbime më të mira</h3>

                <p>
                    Ndihmojmë autoritetet lokale të identifikojnë
                    problemet dhe të reagojnë më shpejt.
                </p>

            </div>


            <div class="mission-card">

                <div class="mission-icon purple">
                    <span>♡</span>
                </div>

                <h3>Komunitet më i fortë</h3>

                <p>
                    Besojmë në bashkëpunimin e qytetarëve për
                    një Prishtinë më të pastër, më të sigurt dhe më të mirë.
                </p>

            </div>

        </div>

    </section>


    <!-- SI FUNKSIONON -->
    <section class="how-section">

        <div class="section-title">

            <h2>Si funksionon?</h2>

            <div class="small-line"></div>

        </div>


        <div class="steps">

            <div class="step">

                <div class="step-icon green">
                    <span>☑</span>
                </div>

                <h3>1. Raporto</h3>

                <p>
                    Dërgo një raportim me detajet dhe vendndodhjen e problemit.
                </p>

            </div>


            <div class="step-arrow">→</div>


            <div class="step">

                <div class="step-icon blue">
                    <span>⌕</span>
                </div>

                <h3>2. Shqyrtohet</h3>

                <p>
                    Raportimi juaj shqyrtohet dhe vlerësohet.
                </p>

            </div>


            <div class="step-arrow">→</div>


            <div class="step">

                <div class="step-icon orange">
                    <span>⚙</span>
                </div>

                <h3>3. Merret veprim</h3>

                <p>
                    Ndërmerren veprimet e nevojshme për zgjidhjen e problemit.
                </p>

            </div>


            <div class="step-arrow">→</div>


            <div class="step">

                <div class="step-icon purple">
                    <span>✓</span>
                </div>

                <h3>4. Ndiq progresin</h3>

                <p>
                    Ndiq statusin dhe përparimin e raportimit tuaj.
                </p>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="about-cta">

        <div class="cta-image">

            <img src="/images/prishtina-illustration.png"
                 alt="Ilustrim i Prishtinës" />

        </div>

        <div class="cta-content">

            <h2>Së bashku për një Prishtinë më të mirë</h2>

            <p>
                Çdo raportim bën ndryshimin. Le të punojmë së bashku
                për ta bërë qytetin tonë një vend për të cilin krenohemi.
            </p>

            <NavLink href="/report" class="cta-button">

                <span>⊕</span>

                Raporto një problem

            </NavLink>

        </div>

    </section>

</div>

