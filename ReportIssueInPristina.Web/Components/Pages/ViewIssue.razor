@page "/issues"
@page "/my-issues"

@using ReportIssueInPristina.Application.Services
@using ReportIssueInPristina.Domain.Models

@inject IReportService ReportService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

<PageTitle>@(showOnlyMine ? "Raportimet e mia" : "Shiko Raportimet") - Prishtina Civic Helper</PageTitle>

<div class="issues-page">
    <section class="issues-header">
        <div>
            <span class="page-kicker">@(showOnlyMine ? "PROFILI IM" : "RAPORTET E KOMUNITETIT")</span>
            <h1>@(showOnlyMine ? "Raportimet e mia" : "Shiko Raportimet")</h1>
            <p>@(showOnlyMine ? "Shikoni dhe ndryshoni problemet që keni raportuar." : "Shfleto të gjitha problemet e raportuara në Prishtinë.")</p>
        </div>
    </section>

    <section class="filter-card">
        <div class="search-box">
            <input @bind="searchText" @bind:event="oninput" @bind:after="ApplyFilters"
                   placeholder="Kërko sipas titullit ose lokacionit..." aria-label="Kërko probleme" />
            <button type="button" @onclick="ApplyFilters" aria-label="Kërko">⌕</button>
        </div>
        <div class="filter-control">
            <select @bind="selectedCategory" @bind:after="ApplyFilters">
                <option value="">Të gjitha kategoritë</option>
                @foreach (var category in categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="filter-control">
            <select @bind="selectedStatus" @bind:after="ApplyFilters">
                <option value="">Të gjitha statuset</option>
                <option value="Në pritje">Në pritje</option>
                <option value="Në proces">Në proces</option>
                <option value="Zgjidhur">Zgjidhur</option>
            </select>
        </div>
        <div class="sort-control">
            <label for="sort">Rendit sipas</label>
            <select id="sort" @bind="selectedSort" @bind:after="ApplyFilters">
                <option value="newest">Më të rejat</option>
                <option value="oldest">Më të vjetrat</option>
            </select>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Duke ngarkuar raportimet...</p>
        </div>
    }
    else if (filteredIssues.Count == 0)
    {
        <div class="empty-state">
            <h2>Nuk u gjet asnjë raportim</h2>
            <button type="button" class="clear-filters-btn" @onclick="ClearFilters">Pastro filtrat</button>
        </div>
    }
    else
    {
        <section class="issues-results">
            <div class="table-wrapper">
                <table class="issues-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Titulli</th>
                            <th>Kategoria</th>
                            <th>Lokacioni</th>
                            <th>Statusi</th>
                            <th>Data</th>
                            <th>Veprimet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in filteredIssues)
                        {
                            <tr>
                                <td class="issue-id">#@issue.Id</td>
                                <td>
                                    <div class="issue-title-cell">
                                        <div class="issue-image">
                                            @if (issue.ImageUrls.Count > 0)
                                            {
                                                <img src="@issue.ImageUrls[0]" alt="@issue.Title" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="image-placeholder">-</div>
                                            }
                                        </div>
                                        <div class="issue-title-content">
                                            <strong>@issue.Title</strong>
                                            <span>@(issue.Category?.Name ?? "Pa kategori")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@(issue.Category?.Name ?? "Pa kategori")</td>
                                <td><span class="location-text">@issue.Location</span></td>
                                <td><span class="status-badge @GetStatusClass(issue.Status)">@GetStatusText(issue.Status)</span>
                                </td>
                                <td>@issue.DateCreated.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="issue-action-buttons">
                                        <button type="button" class="view-button" @onclick="() => OpenIssue(issue)"
                                                aria-label="Shiko raportimin @issue.Id" title="Shiko">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M2 12s3.5-6 10-6s10 6 10 6s-3.5 6-10 6S2 12 2 12Z"></path>
                                                <circle cx="12" cy="12" r="2.5"></circle>
                                            </svg>
                                        </button>
                                        @if (CanEdit(issue))
                                        {
                                            <button type="button" class="icon-action edit-action" @onclick="() => EditIssue(issue)"
                                                    aria-label="Ndrysho raportimin @issue.Id" title="Ndrysho">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M4 20h4L19 9l-4-4L4 16v4Z"></path>
                                                    <path d="m13.5 6.5 4 4"></path>
                                                </svg>
                                            </button>
                                        }
                                        @if (CanDelete(issue))
                                        {
                                            <button type="button" class="icon-action delete-action"
                                                    @onclick="() => DeleteIssue(issue)" aria-label="Fshi raportimin @issue.Id"
                                                    title="Fshi">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M4 7h16"></path>
                                                    <path d="M10 11v6M14 11v6"></path>
                                                    <path d="M6 7l1 13h10l1-13M9 7V4h6v3"></path>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@if (selectedIssue is not null)
{
    <div class="modal-backdrop" @onclick="CloseIssue">
        <div class="issue-modal" @onclick:stopPropagation="true">
            <button type="button" class="modal-close" @onclick="CloseIssue" aria-label="Mbyll">×</button>
            <div class="modal-image">
                @if (selectedIssue.ImageUrls.Count > 0)
                {
                    <img src="@selectedIssue.ImageUrls[currentImageIndex]" alt="@selectedIssue.Title" />
                    @if (selectedIssue.ImageUrls.Count > 1)
                    {
                        <button type="button" class="image-carousel-button previous" @onclick="ShowPreviousImage"
                                aria-label="Fotoja e mëparshme">‹</button>
                        <button type="button" class="image-carousel-button next" @onclick="ShowNextImage"
                                aria-label="Fotoja tjetër">›</button>
                        <span class="image-counter">@(currentImageIndex + 1) / @selectedIssue.ImageUrls.Count</span>
                    }
                }
            </div>
            <div class="modal-content">
                <div class="modal-top">
                    <span class="modal-id">#@selectedIssue.Id</span>
                    <span
                    class="status-badge @GetStatusClass(selectedIssue.Status)">@GetStatusText(selectedIssue.Status)</span>
                </div>
                <span class="modal-category">@(selectedIssue.Category?.Name ?? "Pa kategori")</span>
                <h2>@selectedIssue.Title</h2>
                <div class="modal-location">⌖ @selectedIssue.Location</div>
                <div class="modal-description">
                    <h3>Përshkrimi</h3>
                    <p>@selectedIssue.Description</p>
                </div>
                <div class="modal-actions">
                    @if (CanEdit(selectedIssue))
                    {
                        <button type="button" class="icon-action edit-action" @onclick="() => EditIssue(selectedIssue)"
                                aria-label="Ndrysho raportimin" title="Ndrysho">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 20h4L19 9l-4-4L4 16v4Z"></path>
                                <path d="m13.5 6.5 4 4"></path>
                            </svg>
                        </button>
                    }
                    @if (CanDelete(selectedIssue))
                    {
                        <button type="button" class="icon-action delete-action" @onclick="() => DeleteIssue(selectedIssue)"
                                aria-label="Fshi raportimin" title="Fshi">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 7h16"></path>
                                <path d="M10 11v6M14 11v6"></path>
                                <path d="M6 7l1 13h10l1-13M9 7V4h6v3"></path>
                            </svg>
                        </button>
                    }
                    @if (CurrentUserService.IsAdmin)
                    {
                        <div class="status-editor">
                            <label for="issue-status">Statusi</label>
                            <select id="issue-status" @bind="selectedStatusForEdit">
                                <option value="Në pritje">Në pritje</option>
                                <option value="Në proces">Në proces</option>
                                <option value="Zgjidhur">Zgjidhur</option>
                            </select>
                            <button type="button" class="status-save-button" @onclick="SaveStatus">Ruaj</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (issueToDelete is not null)
{
    <div class="delete-dialog-backdrop" @onclick="CancelDelete">
        <div class="delete-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
             aria-labelledby="delete-dialog-title">
            <div class="delete-dialog-icon">!</div>
            <h2 id="delete-dialog-title">Fshi raportimin?</h2>
            <p>Ky veprim do të fshijë raportimin dhe të gjitha fotot e tij. Nuk mund të zhbëhet.</p>
            <div class="delete-dialog-actions">
                <button type="button" class="dialog-cancel-button" @onclick="CancelDelete">Anulo</button>
                <button type="button" class="dialog-delete-button" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @(isDeleting ? "Duke fshirë..." : "Fshi raportimin")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Issue> allIssues = new();
    private List<Issue> filteredIssues = new();
    private List<string> categories = new();
    private string searchText = string.Empty;
    private string selectedCategory = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedSort = "newest";
    private bool isLoading = true;
    private bool showOnlyMine;
    private Issue? selectedIssue;
    private Issue? issueToDelete;
    private bool isDeleting;
    private int currentImageIndex;
    private string selectedStatusForEdit = "Në pritje";

    protected override async Task OnInitializedAsync()
    {
        var routeIsMine = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("my-issues", StringComparison.OrdinalIgnoreCase);

        await CurrentUserService.InitializeAsync();
        isLoading = true;
        selectedIssue = null;
        searchText = string.Empty;
        selectedCategory = string.Empty;
        selectedStatus = string.Empty;
        selectedSort = "newest";

        showOnlyMine = routeIsMine;

        allIssues = showOnlyMine
            ? (string.IsNullOrWhiteSpace(CurrentUserService.UserId)
                ? new List<Issue>()
                : await ReportService.GetReportByUserAsync(CurrentUserService.UserId))
            : await ReportService.GetAllReportsAsync();

        categories = allIssues.Where(i => i.Category?.Name != null).Select(i => i.Category!.Name!).Distinct().OrderBy(n =>
n).ToList();
        ApplyFilters();
        isLoading = false;
    }

    private void ApplyFilters()
    {
        IEnumerable<Issue> query = allIssues;
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();
            query = query.Where(i => (i.Title?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                     (i.Location?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (!string.IsNullOrWhiteSpace(selectedCategory))
            query = query.Where(i => i.Category?.Name == selectedCategory);
        if (!string.IsNullOrWhiteSpace(selectedStatus))
            query = query.Where(i => GetStatusText(i.Status) == selectedStatus);

        filteredIssues = (selectedSort == "oldest"
            ? query.OrderBy(i => i.DateCreated)
            : query.OrderByDescending(i => i.DateCreated)).ToList();
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedCategory = string.Empty;
        selectedStatus = string.Empty;
        selectedSort = "newest";
        ApplyFilters();
    }

    private void OpenIssue(Issue issue)
    {
        selectedIssue = issue;
        currentImageIndex = 0;
        selectedStatusForEdit = GetStatusText(issue.Status);
    }

    private void CloseIssue() => selectedIssue = null;

    private bool CanEdit(Issue issue) => CurrentUserService.UserId == issue.ApplicationUserId;
    private bool CanDelete(Issue issue) => CurrentUserService.IsAdmin || CanEdit(issue);
    private void EditIssue(Issue issue) => NavigationManager.NavigateTo($"/report-issue/{issue.Id}");

    private void DeleteIssue(Issue issue)
    {
        issueToDelete = issue;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
            issueToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (issueToDelete is null || string.IsNullOrWhiteSpace(CurrentUserService.UserId))
            return;

        isDeleting = true;
        var issue = issueToDelete;
        try
        {
            if (await ReportService.DeleteReportAsync(issue.Id, CurrentUserService.UserId, CurrentUserService.IsAdmin))
            {
                allIssues.Remove(issue);
                if (selectedIssue?.Id == issue.Id)
                    CloseIssue();
                ApplyFilters();
            }
        }
        finally
        {
            issueToDelete = null;
            isDeleting = false;
        }
    }

    private async Task SaveStatus()
    {
        if (selectedIssue is null || !CurrentUserService.IsAdmin)
            return;
        if (await ReportService.UpdateStatusAsync(selectedIssue.Id, selectedStatusForEdit, true))
        {
            selectedIssue.Status = selectedStatusForEdit;
            ApplyFilters();
        }
    }

    private void ShowPreviousImage()
    {
        if (selectedIssue is null || selectedIssue.ImageUrls.Count < 2)
            return;
        currentImageIndex = currentImageIndex == 0 ? selectedIssue.ImageUrls.Count - 1 : currentImageIndex - 1;
    }

    private void ShowNextImage()
    {
        if (selectedIssue is null || selectedIssue.ImageUrls.Count < 2)
            return;
        currentImageIndex = (currentImageIndex + 1) % selectedIssue.ImageUrls.Count;
    }

    private static string GetStatusClass(string? status) => GetStatusText(status).ToLowerInvariant() switch
    {
        "në proces" => "progress",
        "zgjidhur" => "solved",
        _ => "pending"
    };

    private static string GetStatusText(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "në proces" or "in progress" => "Në proces",
        "zgjidhur" or "solved" => "Zgjidhur",
        _ => "Në pritje"
    };
}
