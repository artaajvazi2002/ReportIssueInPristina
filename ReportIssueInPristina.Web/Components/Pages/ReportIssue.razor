@page "/report-issue"
@page "/report-issue/{IssueId:int}"

@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.IO
@using ReportIssueInPristina.Application.Services
@using ReportIssueInPristina.Domain.Models

@inject IReportService ReportService
@inject IImageStorageService ImageStorageService
@inject IJSRuntime JS
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

<PageTitle>@(IsEditMode ? "Ndrysho raportimin" : "Raporto një problem") - Prishtina Civic Helper</PageTitle>

<div class="report-page">

    <!-- =========================
         PAGE HEADER
         ========================= -->
    <div class="report-header">

        <div class="breadcrumb">
            <a href="/">Kryefaqja</a>
            <span>›</span>
            <span>Raporto një problem</span>
        </div>

        <h1>@(IsEditMode ? "Ndrysho raportimin" : "Raporto një problem")</h1>

        <p>
            @(IsEditMode
                ? "Përditësoni detajet e raportimit tuaj."
                : "Ndihmoni në përmirësimin e Prishtinës duke raportuar problemet në qytetin tuaj.")
        </p>

    </div>


    <!-- =========================
         MAIN CONTENT
         ========================= -->
    <div class="report-layout">

        <!-- =========================
             FORM CARD
             ========================= -->
        <div class="form-card">

            <div class="card-title">
                <div class="title-icon">▣</div>

                <h2>Detajet e problemit</h2>
            </div>


            <!-- SUCCESS MESSAGE -->
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="success-message">
                    <span>✓</span>
                    <div>
                        <strong>@(IsEditMode ? "Raportimi u ndryshua me sukses!" : "Raportimi u dërgua me sukses!")</strong>
                        <p>@successMessage</p>
                    </div>
                </div>
            }


            <!-- ERROR MESSAGE -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="error-message">
                    <span>!</span>
                    <div>
                        <strong>Diçka shkoi keq.</strong>
                        <p>@errorMessage</p>
                    </div>
                </div>
            }


            <!-- TITLE -->
            <div class="form-group full-width">

                <label>
                    Titulli <span>*</span>
                </label>

                <input type="text" class="form-control" @bind="issue.Title"
                       placeholder="p.sh. Ndriçimi publik i prishur në Bulevardin Nënë Tereza" />

                @if (showValidation && string.IsNullOrWhiteSpace(issue.Title))
                {
                    <small class="validation-message">
                        Ju lutemi vendosni titullin.
                    </small>
                }

            </div>


            <!-- CATEGORY + OTHER -->
            <div class="form-row">

                <div class="form-group">

                    <label>
                        Kategoria <span>*</span>
                    </label>

                    <select class="form-control" @bind="issue.CategoryId">

                        <option value="0">
                            Zgjidhni kategorinë
                        </option>

                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }

                    </select>

                    @if (showValidation && issue.CategoryId == 0)
                    {
                        <small class="validation-message">
                            Ju lutemi zgjidhni një kategori.
                        </small>
                    }

                </div>


                <div class="form-group">

                    <label>
                        Tjetër
                        <small>(opsionale)</small>
                    </label>

                    <input type="text" class="form-control" placeholder="Specifikoni kategorinë"
                           disabled="@(issue.CategoryId != 6)" />

                </div>

            </div>

            @if (IsEditMode && CurrentUserService.IsAdmin)
            {
                <div class="admin-status-panel">
                    <div>
                        <label>Statusi i raportimit</label>
                        <small>Vetëm administratorët mund ta ndryshojnë statusin.</small>
                    </div>

                    <div class="status-stepper" role="group" aria-label="Ndrysho statusin">
                        @foreach (var status in statuses)
                        {
                            <button type="button"
                                    class="status-step @(selectedEditStatus == status ? "selected" : "")"
                                    @onclick="() => selectedEditStatus = status">
                                <span class="status-dot"></span>
                                <span>@status</span>
                            </button>
                        }
                    </div>
                </div>
            }


            <!-- LOCATION -->
            <div class="form-group full-width">

                <label>
                    Vendndodhja <span>*</span>
                </label>

                <input type="text" class="form-control" @bind="issue.Location"
                       placeholder="p.sh. Bulevardi Nënë Tereza, Prishtinë" />

                @if (showValidation && string.IsNullOrWhiteSpace(issue.Location))
                {
                    <small class="validation-message">
                        Ju lutemi vendosni vendndodhjen.
                    </small>
                }

                <button type="button" class="location-button" @onclick="UseCurrentLocation">

                    <span>⌖</span>

                    Përdor vendndodhjen time

                </button>

            </div>


            <!-- DESCRIPTION -->
            <div class="form-group full-width">

                <label>
                    Përshkrimi <span>*</span>
                </label>

                <textarea class="form-control description" maxlength="1000" @bind="issue.Description"
                          @bind:event="oninput" placeholder="Përshkruani problemin në detaje..."></textarea>

                <div class="character-count">
                    @(issue.Description?.Length ?? 0) / 1000
                </div>

                @if (showValidation && string.IsNullOrWhiteSpace(issue.Description))
                {
                    <small class="validation-message">
                        Ju lutemi përshkruani problemin.
                    </small>
                }

            </div>


            <!-- IMAGE UPLOAD -->
            <div class="form-group full-width">

                <label>
                    Ngarko foto
                    <small>(opsionale)</small>
                </label>

                <label class="upload-box">

                    <div class="upload-icon">☁</div>

                    <div class="upload-content">

                        <strong>
                            Klikoni për të ngarkuar ose tërhiqeni dhe lëshojeni
                        </strong>

                        <small>
                            PNG, JPG deri në 5MB
                        </small>

                        @if (selectedFileNames.Count > 0)
                        {
                            <span class="selected-file">
                                ✓ @string.Join(", ", selectedFileNames)
                            </span>
                        }

                    </div>

                    <InputFile OnChange="HandleFilesSelected" accept=".png,.jpg,.jpeg" multiple class="file-input" />

                </label>

            </div>


            <!-- SUBMIT -->
            <button type="button" class="submit-button" @onclick="SubmitReport" disabled="@isSubmitting">

                @if (isSubmitting)
                {
                    <span class="loading-spinner"></span>
                    <span>Duke dërguar...</span>
                }
                else
                {
                    <span>➤</span>
                    <span>@(IsEditMode ? "Ruaj ndryshimet" : "Dërgo raportimin")</span>
                }

            </button>


            <div class="required-note">
                * Fushat e detyrueshme
            </div>

        </div>


        <!-- =========================
             SIDEBAR
             ========================= -->
        <div class="sidebar">

            <!-- HOW IT WORKS -->
            <div class="side-card">

                <div class="side-title">

                    <div class="info-icon">
                        i
                    </div>

                    <h2>Si funksionon</h2>

                </div>


                <div class="step">

                    <div class="step-icon">
                        ▣
                    </div>

                    <div>
                        <strong>Raporto</strong>

                        <p>
                            Plotësoni formularin me detajet e problemit.
                        </p>
                    </div>

                </div>


                <div class="step">

                    <div class="step-icon">
                        ⚙
                    </div>

                    <div>
                        <strong>Shqyrtohet</strong>

                        <p>
                            Ekipi ynë shqyrton raportimin tuaj.
                        </p>
                    </div>

                </div>


                <div class="step">

                    <div class="step-icon">
                        ⚙
                    </div>

                    <div>
                        <strong>Ndërmerren masa</strong>

                        <p>
                            Ndërmerren masat për zgjidhjen e problemit.
                        </p>
                    </div>

                </div>


                <div class="step">

                    <div class="step-icon">
                        ♡
                    </div>

                    <div>
                        <strong>Ndiq</strong>

                        <p>
                            Mund të ndiqni statusin e raportimit tuaj.
                        </p>
                    </div>

                </div>

            </div>


            <!-- CATEGORIES -->
            <div class="side-card categories-card">

                <div class="side-title">
                    <h2> Më të shpesha</h2>
                </div>

                @foreach (var category in categories)
                {
                    <div class="category-item">

                        <span class="category-icon">
                            @GetCategoryIcon(category.Name)
                        </span>

                        <span>
                            @category.Name
                        </span>

                        <span class="arrow">
                            ›
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


@code {

    private Issue issue = new();

    private List<Category> categories = new();

    private IReadOnlyList<IBrowserFile> selectedFiles = Array.Empty<IBrowserFile>();

    private List<string> selectedFileNames = new();

    private string? errorMessage;

    private string? successMessage;

    private bool showValidation;

    private bool isSubmitting;

    [Parameter]
    public int? IssueId { get; set; }

    private bool IsEditMode => IssueId.HasValue;
    private bool CanEditIssue => issue.ApplicationUserId == CurrentUserService.UserId;
    private readonly string[] statuses = { "Në pritje", "Në proces", "Zgjidhur" };
    private string selectedEditStatus = "Në pritje";


    protected override async Task OnInitializedAsync()
    {
        await CurrentUserService.InitializeAsync();
        categories = await ReportService.GetAllCategoriesAsync();

        if (IssueId.HasValue)
        {
            var existingIssue = await ReportService.GetReportByIdAsync(IssueId.Value);
            if (existingIssue is not null &&
                (existingIssue.ApplicationUserId == CurrentUserService.UserId || CurrentUserService.IsAdmin))
            {
                issue = existingIssue;
                selectedEditStatus = GetStatusText(issue.Status);
            }
            else
            {
                NavigationManager.NavigateTo("/issues");
                return;
            }
        }
    }


    private async Task SubmitReport()
    {
        showValidation = true;

        errorMessage = null;
        successMessage = null;

        if (CurrentUserService.UserId == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (IsEditMode && CurrentUserService.IsAdmin && !CanEditIssue)
        {
            if (await ReportService.UpdateStatusAsync(issue.Id, selectedEditStatus, true))
                successMessage = "Statusi u përditësua me sukses.";
            else
                errorMessage = "Statusi nuk mund të përditësohej.";

            return;
        }

        if (string.IsNullOrWhiteSpace(issue.Title) ||
            issue.CategoryId == 0 ||
            string.IsNullOrWhiteSpace(issue.Location) ||
            string.IsNullOrWhiteSpace(issue.Description))
        {
            errorMessage = "Ju lutemi plotësoni të gjitha fushat e detyrueshme.";
            return;
        }

        try
        {
            isSubmitting = true;

            if (!IsEditMode)
            {
                issue.Status = "Në pritje";
                issue.DateCreated = DateTime.Now;
            }

            foreach (var selectedFile in selectedFiles)
            {
                var extension = Path.GetExtension(selectedFile.Name);
                var fileName = $"{Guid.NewGuid()}{extension}";
                await using var stream =
                    selectedFile.OpenReadStream(5 * 1024 * 1024);
                var imageUrl = await ImageStorageService.UploadAsync(
                    stream,
                    fileName,
                    selectedFile.ContentType);
                issue.ImageUrls.Add(imageUrl);
            }

            if (IsEditMode)
            {
                var updatedIssue = await ReportService.UpdateReportAsync(issue, CurrentUserService.UserId);
                if (updatedIssue is null)
                {
                    errorMessage = "Raportimi nuk mund të ndryshohej.";
                    return;
                }

                if (CurrentUserService.IsAdmin &&
                    !await ReportService.UpdateStatusAsync(issue.Id, selectedEditStatus, true))
                {
                    errorMessage = "Statusi nuk mund të përditësohej.";
                    return;
                }

                issue.Status = CurrentUserService.IsAdmin
                    ? selectedEditStatus
                    : issue.Status;

                successMessage = "Ndryshimet u ruajtën me sukses.";
            }
            else
            {
                issue.ApplicationUserId = CurrentUserService.UserId;
                await ReportService.CreateReportAsync(issue);
                successMessage = "Raportimi juaj është regjistruar dhe do të shqyrtohet nga ekipi.";
                issue = new Issue();
            }

            selectedFiles = Array.Empty<IBrowserFile>();
            selectedFileNames.Clear();
            showValidation = false;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Raportimi nuk mund të dërgohej. {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    private Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(5);
        foreach (var file in files)
        {
            if (file.Size > 5 * 1024 * 1024)
            {
                errorMessage = "Çdo foto nuk mund të jetë më e madhe se 5MB.";
                selectedFiles = Array.Empty<IBrowserFile>();
                selectedFileNames.Clear();
                return Task.CompletedTask;
            }

            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not ".png" and not ".jpg" and not ".jpeg")
            {
                errorMessage = "Lejohen vetëm formatet PNG, JPG dhe JPEG.";
                selectedFiles = Array.Empty<IBrowserFile>();
                selectedFileNames.Clear();
                return Task.CompletedTask;
            }
        }

        selectedFiles = files;
        selectedFileNames = files.Select(file => file.Name).ToList();
        errorMessage = null;
        return Task.CompletedTask;
    }


    private async Task UseCurrentLocation()
    {
        try
        {
            var location = await JS.InvokeAsync<string>(
                "getCurrentLocation");

            issue.Location = location;
        }
        catch
        {
            errorMessage =
                "Nuk mund të merrej vendndodhja juaj. Ju lutemi shkruajeni manualisht.";
        }
    }


    private string GetCategoryIcon(string? categoryName)
    {
        return categoryName switch
        {
            "Dëmtime të rrugëve" => "▲",
            "Ndriçim publik" => "♧",
            "Mbeturina" => "▥",
            "Ujë" => "●",
            "Energjia elektrike" => "ϟ",
            "Tjetër" => "•••",
            _ => "•"
        };
    }

    private static string GetStatusText(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "në proces" or "in progress" => "Në proces",
        "zgjidhur" or "solved" => "Zgjidhur",
        _ => "Në pritje"
    };

}